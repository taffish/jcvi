<shell>
# Discovery exposes a verified root; selecting the resource remains explicit.
taf_jcvi_mount() {
    taf_jcvi_backend="$1"
    taf_jcvi_path=""
    taf_jcvi_target="/jcvi-resource:ro"
    case "${TAFFISH_JCVI_RESOURCE_AUTO_MOUNT:-1}" in
        0) printf -- '--env=TAFFISH_ENV=TAFFISH'; return ;;
        1) ;;
        *) printf >&2 'taf-jcvi: RESOURCE_AUTO_MOUNT must be 0 or 1\n'
           printf -- '--taf-jcvi-invalid-resource'; return ;;
    esac
    if test "${TAFFISH_JCVI_RESOURCE_INSTALL_ROOT+x}" = x; then
        taf_jcvi_path="$TAFFISH_JCVI_RESOURCE_INSTALL_ROOT"
        taf_jcvi_target="/resource-install"
        taf_jcvi_install=1
    else
        taf_jcvi_install=0
        if test "${TAFFISH_JCVI_RESOURCE_PATH+x}" = x; then
            taf_jcvi_path="$TAFFISH_JCVI_RESOURCE_PATH"
        elif test -n "${TAFFISH_JCVI_RESOURCE_ID:-}"; then
            case "$TAFFISH_JCVI_RESOURCE_ID" in
                *[!A-Za-z0-9_.-]*|.*|-*) printf >&2 'taf-jcvi: invalid resource ID\n'
                    printf -- '--taf-jcvi-invalid-resource'; return ;;
            esac
            for taf_jcvi_base in "${TAFFISH_USER_HOME:-$HOME/.local/share/taffish}/resources/jcvi" "${TAFFISH_SYSTEM_HOME:-/usr/local/share/taffish}/resources/jcvi" /opt/taffish/resources/jcvi; do
                if test -e "$taf_jcvi_base/$TAFFISH_JCVI_RESOURCE_ID" || test -L "$taf_jcvi_base/$TAFFISH_JCVI_RESOURCE_ID"; then
                    taf_jcvi_path="$taf_jcvi_base/$TAFFISH_JCVI_RESOURCE_ID"; break
                fi
            done
        else
            printf -- '--env=TAFFISH_ENV=TAFFISH'; return
        fi
    fi
    taf_jcvi_ok=1
    if ! test -d "$taf_jcvi_path"; then taf_jcvi_ok=0; else
        taf_jcvi_path="$(CDPATH= cd "$taf_jcvi_path" && pwd -P)"
        case "$taf_jcvi_path" in *:*|*,*) taf_jcvi_ok=0 ;; esac
        if test "$taf_jcvi_install" = 0; then
            if ! command -v python3 >/dev/null 2>&1; then
                printf >&2 'taf-jcvi: automatic resource verification requires host Python 3; disable auto-mount, verify inside the image and use a manual bind.\n'
                taf_jcvi_ok=0
            elif test -n "${TAFFISH_JCVI_RESOURCE_ID:-}"; then
                python3 -I -B "::*LOADDIR*::/resource_validation.py" verify "$taf_jcvi_path" --expected-resource "$TAFFISH_JCVI_RESOURCE_ID" >&2 || taf_jcvi_ok=0
            else
                python3 -I -B "::*LOADDIR*::/resource_validation.py" verify "$taf_jcvi_path" >&2 || taf_jcvi_ok=0
            fi
        fi
    fi
    if test "$taf_jcvi_ok" != 1; then
        printf >&2 'taf-jcvi: missing/invalid prepared resource root: %s; select RESOURCE_PATH or disable auto-mount for explicit setup/manual paths.\n' "$taf_jcvi_path"
        printf -- '--taf-jcvi-invalid-resource'; return
    fi
    if test "$taf_jcvi_backend" = apptainer; then
        printf -- '--bind=%s:%s' "$taf_jcvi_path" "$taf_jcvi_target"
    else
        printf -- '--volume=%s:%s' "$taf_jcvi_path" "$taf_jcvi_target"
    fi
}
<taf-app:container:ghcr.io/taffish/jcvi:1.6.8-r1$@[docker/podman: "$(taf_jcvi_mount docker)"][docker: --user=$(id -u):$(id -g)][podman: --userns=keep-id --user=$(id -u):$(id -g)][apptainer: "$(taf_jcvi_mount apptainer)"]>
jcvi ::*ARGV*::
